# 核心机密数据（千万不能上传到公共仓库）
accounts/*.json
# 粘性表原子写盘时的临时文件（崩在 replace 之前会留下一个）
accounts/*.json.tmp
accounts/agent-backups/
!accounts/README.txt

# 运行时日志和用量统计
usage/*.jsonl
usage/*.json
usage/*.sqlite3
usage/*.sqlite3-journal
usage/*.sqlite3-wal
usage/*.sqlite3-shm
!usage/README.txt
usage/*.bak*

# 运行时模型目录落盘缓存（上游 /v3/config 成功响应的副本，重启后作兜底；删除安全）
catalog/*.json
catalog/*.tmp
!catalog/README.txt

# 运行时日志文件
logs/

# 测试套件输出（tests/run_all.py --logs 落盘的每个套件的完整输出）
suite-logs/
# 另一种跑法留下的同名目录（部分工具会写到 .testlogs/），同样是临时输出
.testlogs/
tests/_last_all.log
tests/_*.log

# 工作区私有数据（对外项目的克隆、临时脚本、记忆），不进仓库
.workbuddy/

# 便携版内置运行时（仓库只保存纯源码，绿色包通过 Release 发布）
python/
*.zip

# 发布打包产物（wrt/ 脚本的输出，只该出现在 Release 资产里）
dist/
.sdk-cache/
wrt/ipk/
wrt/apk/
# build-apk.sh 把 ca_*.py 暂存进包目录再拷给 SDK，这是构建中间产物
wrt/openwrt/codearts2api/files/usr/lib/

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class

# 系统与编辑器文件
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.codebuddy/

# Local Docker Compose override
docker-compose.override.yml

# 并发会话用的独立检出（不进仓库）
.worktrees/
